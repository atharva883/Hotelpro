# Server Configuration (server/.env)
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/hotelpro
JWT_SECRET=your_jwt_secret_key_here
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Frontend Configuration (client/.env)
VITE_API_URL=/api
